# ── External APIs (required for full functionality) ──────────────────────────
ELEVENLABS_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3-flash-preview
OPENROUTER_REFERER=http://localhost:3000
OPENROUTER_TITLE=Meeting Assistant

# ── Storage / DB ──────────────────────────────────────────────────────────────
STORAGE_DIR=./storage
DATABASE_URL=sqlite+aiosqlite:///./meeting.db

# ── Networking / CORS ─────────────────────────────────────────────────────────
# Comma-separated list of permitted browser origins (scheme + host + port).
# Add every origin the frontend will be served from. Examples:
#   ALLOWED_ORIGIN=http://localhost:3001
#   ALLOWED_ORIGIN=http://localhost:3001,http://your-lan-host:3001
ALLOWED_ORIGIN=http://localhost:3000
# Regex alternative (overrides ALLOWED_ORIGIN if non-empty).
# ALLOWED_ORIGIN_REGEX=^https?://(localhost|your-lan-host):[0-9]+$

# ── Auth / session ────────────────────────────────────────────────────────────
# CHANGE THIS in any non-throwaway deployment. Any random ≥32-char string.
SESSION_SECRET=dev-secret-change-me-in-prod-min-32-chars
SESSION_COOKIE_NAME=ma_session
# Same-site policy. "lax" works for same-site cross-port (localhost:3001 ↔
# localhost:8001). For cross-site (different hostnames) set "none" AND
# SESSION_COOKIE_SECURE=true (requires HTTPS).
SESSION_SAME_SITE=lax
SESSION_COOKIE_SECURE=false
SESSION_MAX_AGE_S=1209600
# Login/register throttle (slowapi syntax: "5/minute", "100/hour", ...).
LOGIN_RATE_LIMIT=5/minute

# ── Keycloak / OIDC (BFF auth) ────────────────────────────────────────────────
# Backend runs the Authorization Code + PKCE flow; the session cookie above
# stays the app's auth primitive (tokens never reach the browser). All four of
# ISSUER/CLIENT_ID/CLIENT_SECRET/REDIRECT_URI are REQUIRED in prod
# (SESSION_COOKIE_SECURE=true) — the app fails fast at startup otherwise.
# Create a CONFIDENTIAL client in the Keycloak admin dashboard (standard flow
# on, direct-access/implicit off) and register the redirect + post-logout URIs.
OIDC_ISSUER=                       # e.g. https://kc.company.com/realms/<realm>
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8000/api/auth/oidc/callback
OIDC_POST_LOGIN_REDIRECT=http://localhost:3000/
OIDC_POST_LOGOUT_REDIRECT=http://localhost:3000/login
OIDC_SCOPES=openid profile email

# ── Transcription tuning ──────────────────────────────────────────────────────
# 1 = single sync convert() (slow on long files). >1 = ffmpeg-split into N
# overlapping chunks, transcribe in parallel, then stitch. Each chunk is
# diarized independently + reconciled at the seams, so MORE chunks = worse
# diarization. Default 2 favors accuracy; raise only to cut Scribe wall-time.
TRANSCRIBE_PARALLEL_CHUNKS=2
TRANSCRIBE_CHUNK_OVERLAP_S=15.0

# ── Server bind ──────────────────────────────────────────────────────────────
# Consumed by the launch command, NOT by the app code:
#   uv run uvicorn app.main:app --host "$HOST" --port "$PORT"
HOST=0.0.0.0
PORT=8000
